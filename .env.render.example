# Obrigatórias
DEBUG=false
SECRET_KEY=substitua-por-uma-chave-longa-aleatoria
DATABASE_URL=postgresql://usuario:senha@host-interno:5432/banco

# Ative somente no primeiro deploy para criar o catálogo demonstrativo.
SEED_DEMO_PRODUCTS=false

# Segurança de produção
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# Necessário somente se houver domínio personalizado.
# O domínio *.onrender.com é incluído automaticamente por RENDER_EXTERNAL_HOSTNAME.
ALLOWED_HOSTS=loja.seudominio.com

# SMTP (opcional; necessário para envio real de e-mails)
EMAIL_HOST=smtp.seuprovedor.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@seudominio.com

# OpenID Connect (opcional; deixe ausente se não utilizar)
OIDC_SERVER_METADATA_URL=https://provedor/.well-known/openid-configuration
OIDC_CLIENT_ID=commerce-web
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Nome do provedor
OIDC_REDIRECT_URI=https://loja.seudominio.com/auth/oidc/callback/
