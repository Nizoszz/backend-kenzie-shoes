SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# O desenvolvimento usa SQLite quando estas variáveis ficam vazias.
# Para usar PostgreSQL local, preencha todas elas.
POSTGRESQL_USERNAME=
POSTGRESQL_PASSWORD=
POSTGRESQL_DB_NAME=
POSTGRESQL_DB_HOST=localhost
POSTGRESQL_DB_PORT=5432

EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Production HTTPS hardening
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000

# OpenID Connect (opcional)
# Valores abaixo funcionam com: docker compose up -d keycloak
OIDC_SERVER_METADATA_URL=http://127.0.0.1:8080/realms/commerce/.well-known/openid-configuration
OIDC_CLIENT_ID=commerce-web
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_PROVIDER_NAME=Keycloak local
# Deve ser exatamente a URI cadastrada no provedor. Vazio usa a URL atual do site.
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/oidc/callback/
